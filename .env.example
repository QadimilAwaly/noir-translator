# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional fallback key for OpenRouter API calls.
# Users can also input their own OpenRouter API key directly in the app settings UI.
OPENROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HOST: Interface tempat server bind. Default 127.0.0.1 (localhost only).
# Set ke 0.0.0.0 hanya jika memang ingin terpapar jaringan, MISALNYA bersama APP_API_TOKEN.
HOST="127.0.0.1"

# PORT: Port server. Default 3131.
# PORT=3131

# APP_API_TOKEN: OPSIONAL — aktifkan autentikasi API token sederhana.
# Jika di-set, semua request ke /api/* wajib menyertakan header "x-api-token: <nilai>" (atau Authorization: Bearer <nilai>).
# Disarankan diset saat HOST=0.0.0.0 untuk mencegah akses tanpa izin.
# APP_API_TOKEN=""

# GLOBAL_STORAGE_PATH: Direktori root tempat novel, chapter Markdown, dan metadata disimpan.
# Alias: NOVEL_LIBRARY_DIR. Default: ./Novel_Library
# GLOBAL_STORAGE_PATH="./Novel_Library"

# CONFIG_PATH: Lokasi file konfigurasi aplikasi config.json. Default: ./config.json
# CONFIG_PATH="./config.json"

# DEFAULT_PROVIDER: Provider AI bawaan ('gemini' | 'openrouter'). Default: gemini
# DEFAULT_PROVIDER="gemini"

# DEFAULT_MODEL / DEFAULT_GEMINI_MODEL: Model default untuk provider Google Gemini.
# Contoh: gemini-2.5-flash, gemini-3.5-flash-lite, gemini-2.5-pro. Default: gemini-2.5-flash
# DEFAULT_MODEL="gemini-2.5-flash"
# DEFAULT_GEMINI_MODEL="gemini-2.5-flash"

# DEFAULT_OPENROUTER_MODEL: Model default untuk provider OpenRouter.
# Contoh: google/gemini-2.5-flash, deepseek/deepseek-chat, anthropic/claude-3.5-sonnet
# Default: google/gemini-2.5-flash
# DEFAULT_OPENROUTER_MODEL="google/gemini-2.5-flash"

# GEMINI_FALLBACK_MODEL: Model cadangan otomatis jika model Gemini utama terkena 503 / High Demand.
# Default: gemini-2.5-pro (jika model utama gemini-2.5-flash), atau gemini-2.5-flash (jika model lain).
# GEMINI_FALLBACK_MODEL="gemini-2.5-pro"

# OPENROUTER_API_URL / OPENROUTER_BASE_URL: Kustom URL endpoint untuk OpenRouter API / proxy gateway.
# Default: https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_API_URL="https://openrouter.ai/api/v1/chat/completions"
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# PROMPT_TEMPLATE_PATH: Path kustom file template prompt sistem penerjemahan.
# Default: ./prompt/translation.md
# PROMPT_TEMPLATE_PATH="./prompt/translation.md"

# DIST_PATH: Path kustom folder static assets untuk mode production. Default: ./dist
# DIST_PATH="./dist"

